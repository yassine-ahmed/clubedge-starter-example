NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local PostgreSQL (PGlite) that pnpm dev starts; no Docker needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Better Auth keeps users and sessions in DATABASE_URL (run pnpm db:migrate first).
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# true refuses sign-in until the email address is confirmed through the emailed link.
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Optional cache and rate limits (Redis protocol; rediss:// enables TLS). Without it, both use
# process memory. Upstash example: rediss://default:YOUR_PASSWORD@your-database.upstash.io:6379
REDIS_URL=

# Email over SMTP: any provider's SMTP endpoint (smtps:// for TLS). Without it, development
# prints emails to the server log and production refuses to send.
SMTP_URL=
EMAIL_FROM=App <no-reply@example.com>

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
# Without an S3 service, files are stored in this folder (relative to the app).
STORAGE_DIRECTORY=../../.data/storage
